# Imagen de desarrollo: `ng serve` con recarga en caliente.
# El código se monta desde el host (docker-compose.yml); node_modules vive en un
# volumen propio para no mezclar binarios de Windows y Linux.
FROM node:22-alpine

WORKDIR /app
ENV NG_CLI_ANALYTICS=false

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund \
 && sha1sum package-lock.json > node_modules/.lock-hash

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

EXPOSE 4200
ENTRYPOINT ["dev-entrypoint.sh"]
# --poll: en Docker Desktop sobre Windows los cambios del host no generan eventos
# de archivo dentro del contenedor; se revisan cada segundo.
CMD ["npx", "ng", "serve", "--host", "0.0.0.0", "--port", "4200", "--poll", "1000"]
